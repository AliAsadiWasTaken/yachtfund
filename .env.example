# Postgres — these configure the server (the postgres image reads them on init)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_SSLMODE=disable

# Client-side, optional. internal/config assembles the DSN from these.
# The local container terminates no TLS, so local development must opt out;
# the default is `require` so that an unset variable is never the insecure one.
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable

# App
PORT=8080
ENV=development

# Escape hatch: set only to point at a database Compose does not manage.
# Leave commented rather than blank — an empty value is still a set value,
# and internal/config would take it over the parts above.
# DATABASE_URL=
